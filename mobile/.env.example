# iOS Simulator and web
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Android Emulator alternative (use this instead of 127.0.0.1)
# EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321

# Copy the local publishable key printed by: npx supabase status
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep false until a production CAPTCHA widget/token-provider adapter is configured.
EXPO_PUBLIC_AUTH_CAPTCHA_REQUIRED=false
